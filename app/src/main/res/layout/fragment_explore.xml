<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F9F9F9">

    <androidx.appcompat.widget.SearchView
        android:id="@+id/searchViewExplore"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:background="@android:drawable/editbox_background_normal"
        app:iconifiedByDefault="false"
        app:queryHint="Cari camilan favoritmu..." />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayoutKategori"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        app:tabIndicatorColor="#FF9800"
        app:tabSelectedTextColor="#FF9800"
        app:tabTextColor="#777777">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Semua" />
        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Manis" />
        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gurih" />
    </com.google.android.material.tabs.TabLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="#FFFFFF"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Harga (Rp): "
            android:textStyle="bold"
            android:textColor="#333333"
            android:textSize="12sp"/>

        <EditText
            android:id="@+id/etMinHarga"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:hint="Min"
            android:inputType="number"
            android:textSize="12sp"
            android:paddingLeft="8dp"
            android:background="@android:drawable/editbox_background_normal"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" - "
            android:textStyle="bold"/>

        <EditText
            android:id="@+id/etMaxHarga"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:hint="Max"
            android:inputType="number"
            android:textSize="12sp"
            android:paddingLeft="8dp"
            android:background="@android:drawable/editbox_background_normal"/>

        <Button
            android:id="@+id/btnApplyFilter"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginLeft="8dp"
            android:text="Filter"
            android:textSize="11sp"
            android:backgroundTint="#FF9800"
            android:textColor="#FFFFFF"/>
    </LinearLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ProgressBar
            android:id="@+id/progressBarExplore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:indeterminateTint="#FF9800"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/tvEmptyExplore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Camilan tidak ditemukan"
            android:textColor="#888888"
            android:layout_centerInParent="true"
            android:visibility="gone"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvExploreProduk"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="4dp"
            android:clipToPadding="false"/>
    </RelativeLayout>
</LinearLayout>