<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9F9F9">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mulai Jual Camilan"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#FF9800"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Foto Produk Camilan"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="8dp"/>

        <ImageView
            android:id="@+id/imgJualPreview"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:background="#E0E0E0"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_camera"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="16dp"/>

        <EditText
            android:id="@+id/etJualNama"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Nama Produk (cth: Makaroni Pedas)"
            android:inputType="text"
            android:background="@android:drawable/editbox_background_normal"
            android:paddingLeft="12dp"
            android:layout_marginBottom="16dp"/>

        <EditText
            android:id="@+id/etJualHarga"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Harga (Rupiah)"
            android:inputType="number"
            android:background="@android:drawable/editbox_background_normal"
            android:paddingLeft="12dp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pilih Kategori"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="8dp"/>

        <Spinner
            android:id="@+id/spinnerJualKategori"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@android:drawable/btn_dropdown"
            android:layout_marginBottom="16dp"/>

        <EditText
            android:id="@+id/etJualDeskripsi"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:hint="Deskripsi camilan, rasa, berat, dll..."
            android:inputType="textMultiLine"
            android:gravity="top|left"
            android:background="@android:drawable/editbox_background_normal"
            android:padding="12dp"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/btnJualUpload"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="UPLOAD PRODUK"
            android:backgroundTint="#FF9800"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>