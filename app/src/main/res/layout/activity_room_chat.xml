<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F4F4">

    <RelativeLayout
        android:id="@+id/rlChatHeader"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FFFFFF"
        android:elevation="4dp"
        android:padding="12dp">
        <TextView
            android:id="@+id/tvHeaderNama"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nama Penjual / Pembeli"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_centerVertical="true"/>
    </RelativeLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvRoomChat"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/rlChatHeader"
        android:layout_above="@id/rlChatInputBottom"
        android:padding="8dp"
        android:clipToPadding="false"/>

    <LinearLayout
        android:id="@+id/rlChatInputBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_alignParentBottom="true"
        android:padding="8dp"
        android:background="#FFFFFF">

        <EditText
            android:id="@+id/etChatInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Ketik pesan..."
            android:background="@android:drawable/editbox_background_normal"
            android:padding="12dp"
            android:maxLines="4"
            android:inputType="textShortMessage"/>

        <Button
            android:id="@+id/btnChatSend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kirim"
            android:layout_marginLeft="6dp"
            android:backgroundTint="#FF9800"
            android:textColor="#FFFFFF"/>
    </LinearLayout>
</RelativeLayout>